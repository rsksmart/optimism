#!/usr/bin/env bash
# RSK fork: block a push that would land unformatted Go code, mirroring the
# `Lint` step of `rsk-test.yml`'s `go-checks` job (PAYROLLUP-137) without
# waiting on CI.
#
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
cd "$(git rev-parse --show-toplevel)"

# git feeds pre-push one line per ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Scope the check to the Go files those refs actually touch, so an unformatted
# file elsewhere in the checkout cannot block a push that has nothing to do
# with it. Each file is then read from the working tree rather than from the
# pushed commit -- see the caveat in AGENTS_rsk.md.
files=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # ref deletion: nothing to format

  # A new remote ref reports an all-zero remote_sha, and a stale or force-moved
  # one can name a commit this clone has never fetched. Both fall back to the
  # fork point off rsk/develop rather than dying on an unknown object.
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$(git merge-base "$local_sha" origin/rsk/develop 2>/dev/null || true)"
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  files+="$(git diff --name-only --diff-filter=ACMR "$range" -- '*.go')"$'\n'
done

# Drop duplicates across refs, blank lines, and paths the working tree no
# longer has (renamed, deleted, or only ever present on another branch).
present=""
while IFS= read -r f; do
  if [ -n "$f" ] && [ -f "$f" ]; then
    present+="$f"$'\n'
  fi
done < <(printf '%s' "$files" | sort -u)
files="$present"

if [ -z "$files" ]; then
  echo "pre-push: no Go files in this push"
  exit 0
fi

if [ ! -x linter/bin/op-golangci-lint ] &&
   { ! command -v just >/dev/null || ! command -v golangci-lint >/dev/null; }; then
  echo "pre-push: need 'just' and 'golangci-lint' on PATH to build the custom linter" >&2
  echo "pre-push: run 'mise install' (mise.toml pins both), or push with --no-verify" >&2
  exit 1
fi

echo "pre-push: checking Go formatting in $(printf '%s' "$files" | grep -c .) file(s)"
printf '%s' "$files" | xargs just fmt-check
