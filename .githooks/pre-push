#!/usr/bin/env bash
# RSK fork: block a push that would land unformatted Go code, mirroring the
# `Lint` step of `rsk-test.yml`'s `go-checks` job (PAYROLLUP-137) without
# waiting on CI.
#
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
cd "$(git rev-parse --show-toplevel)"

if ! command -v just >/dev/null; then
  echo "pre-push: 'just' not found on PATH; run 'mise install', or push with --no-verify" >&2
  exit 1
fi
if [ ! -x linter/bin/op-golangci-lint ] && ! command -v golangci-lint >/dev/null; then
  echo "pre-push: linter/bin/op-golangci-lint is missing and 'golangci-lint' is not on PATH to build it" >&2
  echo "pre-push: run 'mise install' (mise.toml pins both), or push with --no-verify" >&2
  exit 1
fi

# git feeds pre-push one line per ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Scope the check to the Go files those refs actually touch, so an unformatted
# file elsewhere in the checkout cannot block a push that has nothing to do
# with it. Each file is then read from the working tree rather than from the
# pushed commit -- see the caveat in AGENTS_rsk.md.
files=""   # working-tree paths to check, across all pushed refs
stale=""   # checked files whose committed copy differs from the pushed one
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # ref deletion: nothing to format

  # A new remote ref reports an all-zero remote_sha, and a stale or force-moved
  # one can name a commit this clone has never fetched. Both fall back to the
  # fork point off rsk/develop. Without one, skip the ref: a bare-sha `git diff`
  # would compare against the working tree, defeating the scoping above.
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    if ! base="$(git merge-base "$local_sha" origin/rsk/develop 2>/dev/null)"; then
      echo "pre-push: skipping ${local_sha:0:12}: no origin/rsk/develop to diff a new ref against" >&2
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  ref_files=""
  while IFS= read -r f; do
    # Skip paths the working tree no longer has (renamed, deleted, or only
    # ever present on another branch).
    [ -f "$f" ] && ref_files+="$f"$'\n'
  done < <(git diff --name-only --diff-filter=ACMR "$range" -- '*.go')
  [ -n "$ref_files" ] || continue

  files+="$ref_files"
  stale+="$(printf '%s' "$ref_files" | xargs git diff --name-only "$local_sha" --)"$'\n'
done
files="$(printf '%s' "$files" | sort -u)"
stale="$(printf '%s' "$stale" | sort -u | sed '/^$/d')"

if [ -z "$files" ]; then
  echo "pre-push: no Go files in this push"
  exit 0
fi

echo "pre-push: checking Go formatting in $(printf '%s' "$files" | grep -c .) file(s)"
printf '%s' "$files" | xargs just fmt-check

# The check above read the working tree, so a clean result says nothing about
# a file whose committed copy differs -- e.g. after running the formatter to
# clear this hook and pushing again without committing the fix.
if [ -n "$stale" ]; then
  echo "pre-push: note: checked your working-tree copy, which differs from the commit being pushed for:" >&2
  printf '%s\n' "$stale" | sed 's/^/  /' >&2
  echo "pre-push: commit those changes if you want this check to reflect what lands on the remote" >&2
fi
